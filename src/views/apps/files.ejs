<%- include('../partials/header', {title: title}) %>

<!-- Hidden file input for upload -->
<input type="file" id="uploadFileInput" multiple style="display:none;" onchange="handleFileUploadChange(event)" />

<div class="page-header">
  <div>
    <h1 class="page-title">📁 Files — <%= app.name %></h1>
    <% if (currentRelPath) { %>
      <small class="text-muted">/<%= currentRelPath %></small>
    <% } %>
  </div>
  <div class="header-actions">
    <button class="btn btn-secondary" onclick="createEntry('file')">+ New File</button>
    <button class="btn btn-secondary" onclick="createEntry('folder')">+ New Folder</button>
    <button class="btn btn-secondary" onclick="document.getElementById('uploadFileInput').click()" title="Upload files to the current directory">⬆ Upload</button>
    <button id="pasteButton" class="btn btn-secondary" onclick="pasteIntoCurrent()" disabled>Paste</button>
    <a href="/admin/apps/<%= app.id %>" class="btn btn-secondary">← Back to App</a>
  </div>
</div>

<div class="card" id="fileBrowserCard" oncontextmenu="openBackgroundMenu(event)">
  <!-- Breadcrumbs -->
  <div class="file-breadcrumbs">
    <a href="/admin/apps/<%= app.id %>/files" class="breadcrumb-link">📁 root</a>
    <% if (currentRelPath) {
      var parts = currentRelPath.split('/');
      var cumPath = '';
      parts.forEach(function(part, i) {
        cumPath = cumPath ? cumPath + '/' + part : part;
        var isLast = i === parts.length - 1;
    %>
      <span class="breadcrumb-sep">/</span>
      <% if (isLast) { %>
        <span class="breadcrumb-current"><%= part %></span>
      <% } else { %>
        <a href="/admin/apps/<%= app.id %>/files?path=<%= encodeURIComponent(cumPath) %>" class="breadcrumb-link"><%= part %></a>
      <% } %>
    <% }); } %>
  </div>

  <% if (!entries || entries.length === 0) { %>
    <div class="empty-state"><p>Directory is empty or app has not been deployed yet.</p></div>
  <% } else { %>
    <table class="table">
      <thead>
        <tr><th>Name</th><th>Type</th><th>Size</th><th>Actions</th></tr>
      </thead>
      <tbody>
        <% if (currentRelPath) { %>
          <% var parentPath = currentRelPath.includes('/') ? currentRelPath.split('/').slice(0,-1).join('/') : ''; %>
          <tr>
            <td><a href="/admin/apps/<%= app.id %>/files<%= parentPath ? '?path=' + encodeURIComponent(parentPath) : '' %>">📂 ..</a></td>
            <td class="text-muted">directory</td><td>—</td><td>—</td>
          </tr>
        <% } %>
        <% entries.forEach(function(entry) { %>
          <tr class="file-row"
              data-name="<%= entry.name %>"
              data-rel-path="<%= entry.relPath %>"
              data-is-dir="<%= entry.isDir ? '1' : '0' %>"
              data-size="<%= entry.size %>"
              data-can-edit="<%= entry.canEdit ? '1' : '0' %>"
              oncontextmenu="openEntryMenu(event, this)">
            <td>
              <% if (entry.isDir) { %>
                <a href="/admin/apps/<%= app.id %>/files?path=<%= encodeURIComponent(entry.relPath) %>">📂 <%= entry.name %></a>
              <% } else { %>
                <div class="file-name-actions">
                  <span class="file-name-truncate">
                    <span class="file-entry" onclick="editFile('<%= encodeURIComponent(entry.relPath) %>', '<%= app.id %>', <%= entry.canEdit ? 'true' : 'false' %>)">📄 <%= entry.name %></span>
                  </span>
                  <button class="btn btn-sm btn-secondary file-inline-edit <%= entry.canEdit ? '' : 'btn-disabled' %>" <%= entry.canEdit ? '' : 'disabled title="Files over 50MB cannot be edited"' %> onclick="editFile('<%= encodeURIComponent(entry.relPath) %>', '<%= app.id %>', <%= entry.canEdit ? 'true' : 'false' %>)">Edit</button>
                </div>
              <% } %>
            </td>
            <td class="text-muted"><%= entry.isDir ? 'directory' : 'file' %></td>
            <td class="text-muted"><%= entry.isDir ? '—' : (entry.size > 1024 ? Math.round(entry.size/1024) + ' KB' : entry.size + ' B') %></td>
            <td class="text-muted">—</td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<div id="fileContextMenu" class="file-context-menu" style="display:none;">
  <button type="button" class="file-context-item" id="ctxEdit" onclick="contextEdit()">Edit</button>
  <button type="button" class="file-context-item" onclick="contextCopy()">Copy</button>
  <button type="button" class="file-context-item" onclick="contextPaste()">Paste Here</button>
  <button type="button" class="file-context-item" onclick="contextRename()">Rename</button>
  <button type="button" class="file-context-item" id="ctxDownload" onclick="contextDownload()">Download</button>
  <button type="button" class="file-context-item" onclick="contextNewFile()">New File</button>
  <button type="button" class="file-context-item" onclick="contextNewFolder()">New Folder</button>
</div>

<!-- File editor modal -->
<div id="fileModal" class="modal" style="display:none;">
  <div class="modal-overlay" onclick="closeFileModal()"></div>
  <div class="modal-content modal-lg">
    <div class="modal-header">
      <h3 id="fileModalTitle">File</h3>
      <button class="modal-close" onclick="closeFileModal()">✕</button>
    </div>
    <div class="modal-body">
      <div id="fileEditor" class="code-editor"></div>
      <textarea id="fileContentFallback" class="form-input form-textarea" style="display:none;font-family:monospace;min-height:430px;font-size:0.85rem;" spellcheck="false"></textarea>
    </div>
    <div class="modal-footer">
      <button class="btn btn-primary" onclick="saveFile()">💾 Save</button>
      <button class="btn btn-secondary" onclick="closeFileModal()">Cancel</button>
      <span id="saveStatus" class="text-muted" style="margin-left:1rem;"></span>
    </div>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/ace/1.35.4/ace.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
<script>
var currentFilePath = null;
var currentAppId = null;
var copiedEntry = null;
var contextEntry = null;
var editor = null;
var usingFallbackEditor = false;
var currentCanEdit = false;
var currentRelPath = '<%= currentRelPath %>';
var appId = '<%= app.id %>';

function getCsrfToken() {
  var tokenMeta = document.querySelector('meta[name="csrf-token"]');
  return tokenMeta ? tokenMeta.getAttribute('content') : '';
}

function getAceMode(filePath) {
  var lower = String(filePath || '').toLowerCase();
  if (lower.endsWith('.js') || lower.endsWith('.mjs') || lower.endsWith('.cjs') || lower.endsWith('.jsx') || lower.endsWith('.ts') || lower.endsWith('.tsx')) return 'ace/mode/javascript';
  if (lower.endsWith('.json') || lower.endsWith('.jsonc')) return 'ace/mode/json';
  if (lower.endsWith('.md') || lower.endsWith('.markdown')) return 'ace/mode/markdown';
  if (lower.endsWith('.html') || lower.endsWith('.htm') || lower.endsWith('.ejs')) return 'ace/mode/html';
  if (lower.endsWith('.css') || lower.endsWith('.scss') || lower.endsWith('.sass') || lower.endsWith('.less')) return 'ace/mode/css';
  if (lower.endsWith('.yml') || lower.endsWith('.yaml')) return 'ace/mode/yaml';
  if (lower.endsWith('.xml') || lower.endsWith('.svg')) return 'ace/mode/xml';
  if (lower.endsWith('.py')) return 'ace/mode/python';
  if (lower.endsWith('.sh') || lower.endsWith('.bash') || lower.endsWith('.zsh')) return 'ace/mode/sh';
  if (lower.endsWith('.ps1') || lower.endsWith('.bat') || lower.endsWith('.cmd')) return 'ace/mode/powershell';
  if (lower.endsWith('.sql')) return 'ace/mode/sql';
  return 'ace/mode/text';
}

function ensureEditor() {
  if (editor) return;
  if (typeof ace === 'undefined' || !ace || typeof ace.edit !== 'function') {
    usingFallbackEditor = true;
    document.getElementById('fileEditor').style.display = 'none';
    document.getElementById('fileContentFallback').style.display = 'block';
    return;
  }
  editor = ace.edit('fileEditor');
  editor.setTheme('ace/theme/monokai');
  editor.setOptions({
    fontSize: '13px',
    showPrintMargin: false,
    useSoftTabs: true,
    tabSize: 2,
    wrap: true,
  });
}

function editFile(encodedPath, appIdValue, canEdit) {
  if (!canEdit) {
    alert('Files over 50MB or non-text files cannot be edited.');
    return;
  }
  currentFilePath = decodeURIComponent(encodedPath);
  currentAppId = appIdValue;
  currentCanEdit = true;
  ensureEditor();
  document.getElementById('fileModalTitle').textContent = currentFilePath;
  if (usingFallbackEditor) {
    document.getElementById('fileContentFallback').value = 'Loading...';
    document.getElementById('fileContentFallback').readOnly = false;
  } else {
    editor.setValue('Loading...', -1);
    editor.session.setMode(getAceMode(currentFilePath));
    editor.setReadOnly(false);
  }
  document.getElementById('fileModal').style.display = 'flex';
  fetch('/admin/apps/' + appIdValue + '/files/view?path=' + encodedPath, { credentials: 'same-origin' })
    .then(function(r) { return r.json().then(function(data) { return { ok: r.ok, data: data }; }); })
    .then(function(result) {
      if (!result.ok) throw new Error(result.data.error || 'Failed to load file');
      if (usingFallbackEditor) {
        document.getElementById('fileContentFallback').value = result.data.content || '';
      } else {
        editor.setValue(result.data.content || '', -1);
      }
    })
    .catch(function(err) {
      if (usingFallbackEditor) {
        document.getElementById('fileContentFallback').value = 'Error loading file: ' + err.message;
        document.getElementById('fileContentFallback').readOnly = true;
      } else {
        editor.setValue('Error loading file: ' + err.message, -1);
        editor.setReadOnly(true);
      }
      currentCanEdit = false;
    });
}

function closeFileModal() {
  document.getElementById('fileModal').style.display = 'none';
  currentFilePath = null;
}

function saveFile() {
  if (!currentFilePath || !currentAppId || !currentCanEdit) return;
  var content = usingFallbackEditor
    ? document.getElementById('fileContentFallback').value
    : (editor ? editor.getValue() : '');
  var csrfToken = getCsrfToken();
  document.getElementById('saveStatus').textContent = 'Saving…';
  fetch('/admin/apps/' + currentAppId + '/files/save', {
    method: 'POST',
    credentials: 'same-origin',
    headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
    body: JSON.stringify({ path: currentFilePath, content: content })
  })
  .then(function(r) { return r.json().then(function(data) { return { ok: r.ok, data: data }; }); })
  .then(function(result) {
    document.getElementById('saveStatus').textContent = result.ok && result.data.ok ? '✅ Saved' : '❌ ' + (result.data.error || 'Error');
  })
  .catch(function(err) { document.getElementById('saveStatus').textContent = '❌ ' + err.message; });
}

function openEntryMenu(event, rowEl) {
  if (event.button !== 2) return;
  event.preventDefault();
  event.stopPropagation();
  var isDir = rowEl.dataset.isDir === '1';
  contextEntry = {
    relPath: rowEl.dataset.relPath,
    name: rowEl.dataset.name,
    isDir: isDir,
    canEdit: rowEl.dataset.canEdit === '1',
  };
  showContextMenu(event.clientX, event.clientY, contextEntry);
}

function openBackgroundMenu(event) {
  if (event.button !== 2) return;
  if (event.target.closest('tr.file-row')) return;
  event.preventDefault();
  contextEntry = {
    relPath: currentRelPath,
    name: currentRelPath || 'root',
    isDir: true,
    canEdit: false,
  };
  showContextMenu(event.clientX, event.clientY, contextEntry);
}

function showContextMenu(x, y, entry) {
  var menu = document.getElementById('fileContextMenu');
  var editItem = document.getElementById('ctxEdit');
  var downloadItem = document.getElementById('ctxDownload');

  if (entry.isDir) {
    editItem.classList.add('hidden');
    downloadItem.classList.add('hidden');
  } else {
    editItem.classList.remove('hidden');
    downloadItem.classList.remove('hidden');
    if (!entry.canEdit) editItem.classList.add('disabled');
    else editItem.classList.remove('disabled');
  }

  menu.style.left = x + 'px';
  menu.style.top = y + 'px';
  menu.style.display = 'block';
}

function hideContextMenu() {
  var menu = document.getElementById('fileContextMenu');
  menu.style.display = 'none';
}

function contextEdit() {
  if (!contextEntry || contextEntry.isDir || !contextEntry.canEdit) return;
  editFile(encodeURIComponent(contextEntry.relPath), appId, true);
  hideContextMenu();
}

function contextCopy() {
  if (!contextEntry) return;
  copyEntry(encodeURIComponent(contextEntry.relPath), contextEntry.isDir);
  hideContextMenu();
}

function contextPaste() {
  if (!contextEntry) return;
  pasteIntoFolder(encodeURIComponent(contextEntry.isDir ? contextEntry.relPath : currentRelPath));
  hideContextMenu();
}

function contextRename() {
  if (!contextEntry) return;
  renameEntry(encodeURIComponent(contextEntry.relPath));
  hideContextMenu();
}

function contextDownload() {
  if (!contextEntry || contextEntry.isDir) return;
  downloadEntry(encodeURIComponent(contextEntry.relPath));
  hideContextMenu();
}

function contextNewFile() {
  createEntry('file');
  hideContextMenu();
}

function contextNewFolder() {
  createEntry('folder');
  hideContextMenu();
}

function copyEntry(encodedPath, isDir) {
  copiedEntry = {
    sourcePath: decodeURIComponent(encodedPath),
    isDir: !!isDir,
  };
  document.getElementById('pasteButton').disabled = false;
}

function pasteIntoCurrent() {
  pasteIntoFolder(encodeURIComponent(currentRelPath));
}

function pasteIntoFolder(encodedDestinationPath) {
  if (!copiedEntry) {
    alert('Copy a file or folder first.');
    return;
  }

  fetch('/admin/apps/' + appId + '/files/paste', {
    method: 'POST',
    credentials: 'same-origin',
    headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': getCsrfToken() },
    body: JSON.stringify({ sourcePath: copiedEntry.sourcePath, destinationPath: decodeURIComponent(encodedDestinationPath || '') })
  })
    .then(function(r) { return r.json().then(function(data) { return { ok: r.ok, data: data }; }); })
    .then(function(result) {
      if (!result.ok) throw new Error(result.data.error || 'Paste failed');
      window.location.reload();
    })
    .catch(function(err) { alert(err.message); });
}

function renameEntry(encodedPath) {
  var oldRelPath = decodeURIComponent(encodedPath);
  var currentName = oldRelPath.split('/').pop();
  var newName = prompt('Rename to:', currentName);
  if (newName === null) return;
  fetch('/admin/apps/' + appId + '/files/rename', {
    method: 'POST',
    credentials: 'same-origin',
    headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': getCsrfToken() },
    body: JSON.stringify({ path: oldRelPath, newName: newName })
  })
    .then(function(r) { return r.json().then(function(data) { return { ok: r.ok, data: data }; }); })
    .then(function(result) {
      if (!result.ok) throw new Error(result.data.error || 'Rename failed');
      window.location.reload();
    })
    .catch(function(err) { alert(err.message); });
}

function createEntry(type) {
  var label = type === 'folder' ? 'folder' : 'file';
  var name = prompt('New ' + label + ' name:');
  if (name === null) return;

  fetch('/admin/apps/' + appId + '/files/create', {
    method: 'POST',
    credentials: 'same-origin',
    headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': getCsrfToken() },
    body: JSON.stringify({ type: type, parentPath: currentRelPath, name: name })
  })
    .then(function(r) { return r.json().then(function(data) { return { ok: r.ok, data: data }; }); })
    .then(function(result) {
      if (!result.ok) throw new Error(result.data.error || 'Create failed');
      window.location.reload();
    })
    .catch(function(err) { alert(err.message); });
}

function downloadEntry(encodedPath) {
  window.location.href = '/admin/apps/' + appId + '/files/download?path=' + encodedPath;
}

/**
 * Upload one or more files to the current directory.
 * Files are sent as raw binary requests (application/octet-stream).
 * The destination directory is passed via the X-File-Path header.
 */
function handleFileUploadChange(event) {
  var files = event.target.files;
  if (!files || files.length === 0) return;

  var uploadQueue = Array.from(files);
  var successCount = 0;
  var failMessages = [];

  function uploadNext() {
    if (uploadQueue.length === 0) {
      if (failMessages.length > 0) {
        alert('Upload completed with errors:\n' + failMessages.join('\n'));
      }
      window.location.reload();
      return;
    }

    var file = uploadQueue.shift();
    fetch('/admin/apps/' + appId + '/files/upload', {
      method: 'POST',
      credentials: 'same-origin',
      headers: {
        'Content-Type': 'application/octet-stream',
        'X-File-Name': file.name,
        'X-File-Path': currentRelPath || '',
        'X-CSRF-Token': getCsrfToken(),
      },
      body: file,
    })
      .then(function(r) { return r.json().then(function(data) { return { ok: r.ok, data: data }; }); })
      .then(function(result) {
        if (result.ok) {
          successCount += 1;
        } else {
          failMessages.push(file.name + ': ' + (result.data.error || 'Unknown error'));
        }
        uploadNext();
      })
      .catch(function(err) {
        failMessages.push(file.name + ': ' + (err.message || 'Network error'));
        uploadNext();
      });
  }

  uploadNext();
  // Reset the input so the same file can be uploaded again if needed.
  event.target.value = '';
}

document.addEventListener('click', function() {
  hideContextMenu();
});

document.addEventListener('keydown', function(event) {
  if (event.key === 'Escape') {
    hideContextMenu();
    closeFileModal();
  }
});
</script>

<%- include('../partials/footer') %>
