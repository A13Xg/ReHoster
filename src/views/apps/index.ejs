<%- include('../partials/header', {title: title}) %>

<div class="page-header">
  <h1 class="page-title">Apps</h1>
  <a href="/admin/apps/new" class="btn btn-primary">+ Deploy New App</a>
</div>

<div class="stats-row">
  <span class="stat-pill stat-counter">Total: <strong><%= stats.total %></strong></span>
  <span class="stat-pill running stat-counter">Running: <strong><%= stats.running %></strong></span>
  <span class="stat-pill stopped stat-counter">Stopped: <strong><%= stats.stopped %></strong></span>
  <span class="stat-pill missing stat-counter">Missing: <strong><%= stats.missing %></strong></span>
  <span class="stat-pill failed stat-counter">Failed: <strong><%= stats.failed %></strong></span>
</div>

<div class="card">
  <% if (apps.length === 0) { %>
    <div class="empty-state">
      <p>No apps deployed yet.</p>
      <a href="/admin/apps/new" class="btn btn-primary">Deploy Your First App</a>
    </div>
  <% } else { %>
    <table class="table">
      <thead>
        <tr>
          <th><input type="checkbox" id="selectAll" title="Select all" /></th>
          <th>Name</th>
          <th>Repo</th>
          <th>Branch</th>
          <th>Port Mapping</th>
          <th>Status</th>
          <th>Health</th>
          <th>Last Deployed</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% apps.forEach(function(app) { %>
          <tr data-app-id="<%= app.id %>">
            <td><input type="checkbox" class="app-checkbox" value="<%= app.id %>" /></td>
            <td>
              <strong><a href="/admin/apps/<%= app.id %>" class="app-link"><%= app.name %></a></strong>
              <br/><small class="text-muted"><%= app.safe_name %></small>
              <% if (app.group) { %>
                <br/><span class="group-dot" style="background:<%= app.group.color %>"></span><small class="text-muted"><%= app.group.name %></small>
              <% } %>
              <% if (app.frameworks && app.frameworks.length > 0) { %>
                <div class="framework-badges">
                  <% app.frameworks.forEach(function(fw) { %>
                    <span class="fw-badge" style="background:<%= fw.color %>22;color:<%= fw.color %>;border:1px solid <%= fw.color %>44"><%= fw.label %></span>
                  <% }) %>
                </div>
              <% } %>
              <% if (app.tags) { %>
                <div class="tag-badges">
                  <% app.tags.split(',').map(t => t.trim()).filter(Boolean).forEach(function(tag) { %>
                    <span class="tag-badge"><%= tag %></span>
                  <% }) %>
                </div>
              <% } %>
            </td>
            <td>
              <a href="<%= app.repo_url %>" target="_blank" rel="noopener noreferrer" class="text-muted repo-link">
                <%= app.repo_url.replace('https://github.com/', '').replace('git@github.com:', '') %>
              </a>
            </td>
            <td><code><%= app.branch %></code></td>
            <td><code><%= app.port %> → <%= app.container_port || 3000 %></code></td>
            <td><%- include('../partials/status-badge', {status: app.status}) %></td>
            <td>
              <% if (app.health_status === 'healthy') { %>
                <span class="health-dot health-healthy" title="Healthy"></span>
              <% } else if (app.health_status === 'degraded') { %>
                <span class="health-dot health-degraded" title="Degraded"></span>
              <% } else if (app.health_status === 'unhealthy') { %>
                <span class="health-dot health-unhealthy" title="Unhealthy"></span>
              <% } else { %>
                <span class="health-dot health-unknown" title="Unknown"></span>
              <% } %>
            </td>
            <td class="text-muted">
              <%= formatDate(app.last_deployed_at) %>
            </td>
            <td class="actions-cell">
              <a href="/admin/apps/<%= app.id %>" class="btn btn-sm btn-secondary">View</a>
              <% if (app.status === 'stopped' || app.status === 'failed') { %>
                <form action="/admin/apps/<%= app.id %>/start" method="POST" class="inline-form">
                  <button type="submit" class="btn btn-sm btn-success">Start</button>
                </form>
              <% } %>
              <% if (app.status === 'running') { %>
                <form action="/admin/apps/<%= app.id %>/stop" method="POST" class="inline-form">
                  <button type="submit" class="btn btn-sm btn-warning">Stop</button>
                </form>
                <form action="/admin/apps/<%= app.id %>/restart" method="POST" class="inline-form">
                  <button type="submit" class="btn btn-sm btn-secondary">Restart</button>
                </form>
              <% } %>
              <form action="/admin/apps/<%= app.id %>/rebuild" method="POST" class="inline-form">
                <button type="submit" class="btn btn-sm btn-info confirm-action" data-confirm="Rebuild app '<%= app.name %>'?">Rebuild</button>
              </form>
              <a href="/admin/apps/<%= app.id %>/logs" class="btn btn-sm btn-secondary">Logs</a>
              <form action="/admin/apps/<%= app.id %>/delete" method="POST" class="inline-form">
                <button type="submit" class="btn btn-sm btn-danger confirm-action" data-confirm="Delete app '<%= app.name %>'? This cannot be undone.">Delete</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <div class="bulk-actions" id="bulkActions" style="display:none;">
      <span class="bulk-count" id="bulkCount">0 selected</span>
      <button class="btn btn-sm btn-success" onclick="bulkAction('start')">▶ Start Selected</button>
      <button class="btn btn-sm btn-warning" onclick="bulkAction('stop')">⏹ Stop Selected</button>
      <button class="btn btn-sm btn-secondary" onclick="bulkAction('restart')">↺ Restart Selected</button>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
