<%- include('../partials/header', {title: title}) %>

<div class="page-header">
  <div>
    <h1 class="page-title"><%= app.name %></h1>
    <small class="text-muted">/<%= app.safe_name %></small>
    <% if (frameworks && frameworks.length > 0) { %>
      <div class="framework-badges" style="margin-top:6px;">
        <% frameworks.forEach(function(fw) { %>
          <span class="fw-badge" style="background:<%= fw.color %>22;color:<%= fw.color %>;border:1px solid <%= fw.color %>44"><%= fw.label %></span>
        <% }) %>
      </div>
    <% } %>
  </div>
  <a href="/admin/apps" class="btn btn-secondary">← Back to Apps</a>
</div>

<% if (envUpdated) { %>
  <div class="alert alert-success">
    Environment variables saved.<% if (envApplyNow) { %> Rebuild started to apply changes to the running container.<% } else { %> Rebuild or restart/redeploy to apply changes to runtime.<% } %>
  </div>
<% } %>

<% if (detailsUpdated) { %>
  <div class="alert alert-success">
    App details saved.<% if (detailsRedeploy) { %> Re-deploy started in the background.<% } %>
  </div>
<% } %>

<% if (detailsError) { %>
  <div class="alert alert-danger">
    Failed to update app details: <%= detailsError %>
  </div>
<% } %>

<div class="detail-grid">
  <div class="card detail-card">
    <div class="card-header">
      <h2>App Details</h2>
      <%- include('../partials/status-badge', {status: app.status}) %>
    </div>
    <div class="detail-list">
      <% if (app.description) { %>
      <div class="detail-row">
        <span class="detail-label">Description</span>
        <span class="detail-value"><%= app.description %></span>
      </div>
      <% } %>
      <% if (group) { %>
      <div class="detail-row">
        <span class="detail-label">Group</span>
        <span class="detail-value"><span class="group-dot" style="background:<%= group.color %>"></span> <%= group.name %></span>
      </div>
      <% } %>
      <div class="detail-row">
        <span class="detail-label">Status</span>
        <span class="detail-value"><%- include('../partials/status-badge', {status: app.status}) %></span>
      </div>
      <div class="detail-row">
        <span class="detail-label">External Host Port</span>
        <span class="detail-value">
          <code><%= app.port %></code>
          <button class="copy-btn" data-copy="<%= app.port %>" title="Copy port">📋</button>
        </span>
      </div>
      <div class="detail-row">
        <span class="detail-label">Internal Container Port</span>
        <span class="detail-value"><code><%= app.container_port || 3000 %></code></span>
      </div>
      <div class="detail-row">
        <span class="detail-label">Port Mapping</span>
        <span class="detail-value"><code><%= app.port %> → <%= app.container_port || 3000 %></code></span>
      </div>
      <div class="detail-row">
        <span class="detail-label">URL</span>
        <span class="detail-value">
          <a href="<%= baseHost %>:<%= app.port %>" target="_blank" rel="noopener noreferrer">
            <%= baseHost %>:<%= app.port %>
          </a>
          <button class="copy-btn" data-copy="<%= baseHost %>:<%= app.port %>" title="Copy URL">📋</button>
        </span>
      </div>
      <% if (app.public_hostname) { %>
      <div class="detail-row">
        <span class="detail-label">Public Hostname</span>
        <span class="detail-value">
          <a href="<%= app.public_hostname %>" target="_blank" rel="noopener noreferrer"><%= app.public_hostname %></a>
          <button class="copy-btn" data-copy="<%= app.public_hostname %>" title="Copy">📋</button>
        </span>
      </div>
      <% } %>
      <div class="detail-row">
        <span class="detail-label">Service Type</span>
        <span class="detail-value"><code><%= app.service_type || 'auto' %></code></span>
      </div>
      <div class="detail-row">
        <span class="detail-label">Health</span>
        <span class="detail-value">
          <% if (app.health_status === 'healthy') { %>
            <span class="health-dot health-healthy"></span> Healthy
          <% } else if (app.health_status === 'degraded') { %>
            <span class="health-dot health-degraded"></span> Degraded
          <% } else if (app.health_status === 'unhealthy') { %>
            <span class="health-dot health-unhealthy"></span> Unhealthy
          <% } else { %>
            <span class="health-dot health-unknown"></span> Unknown
          <% } %>
          <% if (app.last_health_check) { %>
            <small class="text-muted">(checked <%= new Date(app.last_health_check).toLocaleTimeString() %>)</small>
          <% } %>
        </span>
      </div>
      <div class="detail-row">
        <span class="detail-label">Container</span>
        <span class="detail-value"><code><%= app.container_name %></code></span>
      </div>
      <div class="detail-row">
        <span class="detail-label">Image</span>
        <span class="detail-value"><code><%= app.image_name %></code></span>
      </div>
      <div class="detail-row">
        <span class="detail-label">Repository</span>
        <span class="detail-value">
          <a href="<%= app.repo_url %>" target="_blank" rel="noopener noreferrer"><%= app.repo_url %></a>
        </span>
      </div>
      <div class="detail-row">
        <span class="detail-label">Branch</span>
        <span class="detail-value"><code><%= app.branch %></code></span>
      </div>
      <div class="detail-row">
        <span class="detail-label">Webhook URL</span>
        <span class="detail-value">
          <code><%= webhookUrl %></code>
          <button class="copy-btn" data-copy="<%= webhookUrl %>" title="Copy webhook URL">📋</button>
        </span>
      </div>
      <div class="detail-row">
        <span class="detail-label">Build Command</span>
        <span class="detail-value"><code><%= app.build_command || '—' %></code></span>
      </div>
      <div class="detail-row">
        <span class="detail-label">Start Command</span>
        <span class="detail-value"><code><%= app.start_command || '—' %></code></span>
      </div>
      <% if (app.post_start_command) { %>
      <div class="detail-row">
        <span class="detail-label">Post-Start Cmd</span>
        <span class="detail-value"><code><%= app.post_start_command %></code></span>
      </div>
      <% } %>
      <% if (app.cpu_limit) { %>
      <div class="detail-row">
        <span class="detail-label">CPU Limit</span>
        <span class="detail-value"><code><%= app.cpu_limit %></code></span>
      </div>
      <% } %>
      <% if (app.memory_limit) { %>
      <div class="detail-row">
        <span class="detail-label">Memory Limit</span>
        <span class="detail-value"><code><%= app.memory_limit %></code></span>
      </div>
      <% } %>
      <% if (app.tags) { %>
      <div class="detail-row">
        <span class="detail-label">Tags</span>
        <span class="detail-value">
          <% app.tags.split(',').map(t => t.trim()).filter(Boolean).forEach(function(tag) { %>
            <span class="tag-badge"><%= tag %></span>
          <% }) %>
        </span>
      </div>
      <% } %>
      <div class="detail-row">
        <span class="detail-label">Created</span>
        <span class="detail-value"><%= formatDate(app.created_at) %></span>
      </div>
      <div class="detail-row">
        <span class="detail-label">Last Deployed</span>
        <span class="detail-value"><%= formatDate(app.last_deployed_at) %></span>
      </div>
    </div>
  </div>

  <div class="card actions-card">
    <div class="card-header"><h2>Actions</h2></div>
    <div class="actions-list">
      <% if (app.status === 'stopped' || app.status === 'failed') { %>
        <form action="/admin/apps/<%= app.id %>/start" method="POST">
          <button type="submit" class="btn btn-success btn-block">▶ Start</button>
        </form>
      <% } %>
      <% if (app.status === 'running') { %>
        <form action="/admin/apps/<%= app.id %>/stop" method="POST">
          <button type="submit" class="btn btn-warning btn-block">⏹ Stop</button>
        </form>
        <form action="/admin/apps/<%= app.id %>/restart" method="POST">
          <button type="submit" class="btn btn-secondary btn-block">↺ Restart</button>
        </form>
      <% } %>
      <form action="/admin/apps/<%= app.id %>/rebuild" method="POST">
        <button type="submit" class="btn btn-info btn-block confirm-action" data-confirm="Rebuild '<%= app.name %>'? This will stop and re-deploy it.">
          🔨 Rebuild
        </button>
      </form>
      <form action="/admin/apps/<%= app.id %>/pull" method="POST">
        <button type="submit" class="btn btn-info btn-block confirm-action" data-confirm="Pull latest and redeploy '<%= app.name %>'?">
          ⬇ Pull &amp; Redeploy
        </button>
      </form>
      <a href="/admin/apps/<%= app.id %>/logs" class="btn btn-secondary btn-block">📋 View Logs</a>
      <a href="/admin/apps/<%= app.id %>/files" class="btn btn-secondary btn-block">📁 File Browser</a>
      <hr class="divider" />
      <form action="/admin/apps/<%= app.id %>/delete" method="POST">
        <button type="submit" class="btn btn-danger btn-block confirm-action" data-confirm="Permanently delete '<%= app.name %>'? This cannot be undone.">
          🗑 Delete App
        </button>
      </form>
    </div>
    <div style="margin-top:1rem;padding-top:1rem;border-top:1px solid var(--border);">
      <small class="text-muted">Keyboard shortcuts: press <kbd>?</kbd> for help</small>
    </div>
  </div>
</div>

<div class="card" style="margin-top:1.5rem;">
  <div class="card-header">
    <h2>Edit App Details</h2>
  </div>
  <form action="/admin/apps/<%= app.id %>/details" method="POST" class="app-form" style="padding:1rem;">
    <div class="form-grid">
      <div class="form-group">
        <label class="form-label" for="nameEdit">App Name</label>
        <input class="form-input" type="text" id="nameEdit" name="name" maxlength="50" required value="<%= app.name || '' %>" />
      </div>

      <div class="form-group">
        <label class="form-label" for="repoUrlEdit">GitHub Repository URL</label>
        <input class="form-input" type="text" id="repoUrlEdit" name="repoUrl" required value="<%= app.repo_url || '' %>" />
      </div>

      <div class="form-group">
        <label class="form-label" for="branchEdit">Branch</label>
        <input class="form-input" type="text" id="branchEdit" name="branch" required value="<%= app.branch || 'main' %>" />
      </div>

      <div class="form-group">
        <label class="form-label" for="serviceTypeEdit">Service Type</label>
        <select class="form-input" id="serviceTypeEdit" name="service_type">
          <option value="auto" <%= (app.service_type || 'auto') === 'auto' ? 'selected' : '' %>>Auto-detect</option>
          <option value="node" <%= app.service_type === 'node' ? 'selected' : '' %>>Node.js</option>
          <option value="static" <%= app.service_type === 'static' ? 'selected' : '' %>>Static / HTML</option>
        </select>
      </div>

      <div class="form-group">
        <label class="form-label" for="hostPortEdit">External Host Port</label>
        <input class="form-input" type="number" id="hostPortEdit" name="port" min="1" max="65535" required value="<%= app.port || '' %>" />
      </div>

      <div class="form-group">
        <label class="form-label" for="containerPortEdit">Internal Container Port</label>
        <input class="form-input" type="number" id="containerPortEdit" name="containerPort" min="1" max="65535" required value="<%= app.container_port || '' %>" />
      </div>

      <div class="form-group">
        <label class="form-label" for="buildCommandEdit">Build Command</label>
        <input class="form-input" type="text" id="buildCommandEdit" name="buildCommand" value="<%= app.build_command || '' %>" />
      </div>

      <div class="form-group">
        <label class="form-label" for="startCommandEdit">Start Command</label>
        <input class="form-input" type="text" id="startCommandEdit" name="startCommand" value="<%= app.start_command || '' %>" />
      </div>

      <div class="form-group">
        <label class="form-label" for="postStartCommandEdit">
          Post-Start Command
          <span class="text-muted" style="font-weight:400;text-transform:none;">(optional)</span>
        </label>
        <input class="form-input" type="text" id="postStartCommandEdit" name="post_start_command" placeholder="python manage.py migrate" value="<%= app.post_start_command || '' %>" />
        <small class="form-hint" style="font-size:0.78rem;color:var(--text-muted);">Runs inside the container after startup (max 30 s wait). Use for migrations, seed scripts, etc.</small>
      </div>

      <div class="form-group">
        <label class="form-label" for="groupEdit">Group</label>
        <select class="form-input" id="groupEdit" name="group_id">
          <option value="">- No Group -</option>
          <% if (groups && groups.length > 0) { groups.forEach(function(g) { %>
            <option value="<%= g.id %>" <%= app.group_id === g.id ? 'selected' : '' %>><%= g.name %></option>
          <% }) } %>
        </select>
      </div>

      <div class="form-group">
        <label class="form-label" for="publicHostnameEdit">Public Hostname</label>
        <input class="form-input" type="text" id="publicHostnameEdit" name="public_hostname" value="<%= app.public_hostname || '' %>" />
      </div>

      <div class="form-group">
        <label class="form-label" for="tagsEdit">Tags</label>
        <input class="form-input" type="text" id="tagsEdit" name="tags" value="<%= app.tags || '' %>" />
      </div>

      <div class="form-group">
        <label class="form-label" for="cpuLimitEdit">CPU Limit</label>
        <input class="form-input" type="text" id="cpuLimitEdit" name="cpu_limit" value="<%= app.cpu_limit || '' %>" />
      </div>

      <div class="form-group">
        <label class="form-label" for="memoryLimitEdit">Memory Limit</label>
        <input class="form-input" type="text" id="memoryLimitEdit" name="memory_limit" value="<%= app.memory_limit || '' %>" />
      </div>

      <div class="form-group form-group-full">
        <label class="form-label" for="descriptionEdit">Description</label>
        <textarea class="form-input form-textarea" id="descriptionEdit" name="description" rows="3"><%= app.description || '' %></textarea>
      </div>
    </div>

    <div class="form-actions" style="margin-top:0.5rem;">
      <button type="submit" class="btn btn-primary">Save Details &amp; Re-deploy</button>
    </div>
  </form>
</div>

<div class="card" style="margin-top:1.5rem;">
  <div class="card-header">
    <h2>Environment Variables</h2>
  </div>
  <div class="env-vault">
    <form action="/admin/apps/<%= app.id %>/env" method="POST">
      <div class="form-group" style="margin-bottom:0.75rem;">
        <label class="form-label" for="envVarsEdit">Edit Variables</label>
        <textarea class="form-input form-textarea" id="envVarsEdit" name="envVars" rows="8" placeholder="KEY=value&#10;ACCESS_CODE=example"><%= envVarsText || '' %></textarea>
        <small class="form-hint">One KEY=VALUE per line. Supports quoted values and export KEY=value format.</small>
      </div>
      <div class="form-group" style="margin-bottom:0.75rem;">
        <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
          <input type="checkbox" name="applyNow" value="1" />
          <span>Apply now (trigger rebuild)</span>
        </label>
      </div>
      <div>
        <button type="submit" class="btn btn-primary">💾 Save Env Vars</button>
      </div>
    </form>
  </div>
</div>

<div class="card" style="margin-top: 1.5rem;">
  <div class="card-header">
    <h2>Recent Deployment Logs</h2>
    <a href="/admin/apps/<%= app.id %>/logs" class="btn btn-sm btn-secondary">View All Logs</a>
  </div>
  <% if (!logs || logs.length === 0) { %>
    <div class="empty-state"><p>No deployment logs yet.</p></div>
  <% } else { %>
    <div class="log-viewer">
      <% logs.forEach(function(log) { %>
        <div class="log-line log-<%= log.level %>">
          <span class="log-time"><%= new Date(log.created_at).toLocaleTimeString() %></span>
          <span class="log-level">[<%= log.level.toUpperCase() %>]</span>
          <span class="log-msg"><%= log.message %></span>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
