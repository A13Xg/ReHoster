<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Error <%= status %> — ReHoster</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text x='50' y='80' font-size='90' text-anchor='middle' fill='%23818cf8'>⚡</text></svg>" />
  <link rel="apple-touch-icon" href="/media/Re-HosterLogo.png" />
  <link rel="stylesheet" href="/css/styles.css" />
</head>
<body class="login-body">
  <div class="login-container">
    <div class="login-card" style="max-width: 600px;">
      <div class="login-brand">
        <img class="brand-icon" src="/media/Re-HosterLogo.png" alt="ReHoster logo" />
        <span class="brand-name">ReHoster</span>
      </div>
      <h2 class="login-title" style="color: var(--color-danger);">Error <%= status %></h2>
      <p style="color: var(--text-secondary); margin-bottom: 1rem;"><%= message %></p>
      <% if (stack) { %>
        <pre class="log-viewer" style="font-size: 0.75rem; max-height: 300px; overflow:auto;"><%= stack %></pre>
      <% } %>
      <a href="/admin" class="btn btn-primary" style="margin-top:1rem;">Go to Dashboard</a>
    </div>
  </div>
</body>
</html>
