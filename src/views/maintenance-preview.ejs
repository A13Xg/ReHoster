<%- include('partials/header', {title: title}) %>

<div class="page-header">
  <h1 class="page-title">👁 Maintenance Page Preview</h1>
  <a href="/admin/settings" class="btn btn-secondary">← Back to Settings</a>
</div>

<div class="card">
  <div class="card-header"><h2>Preview</h2></div>
  <div style="border:1px solid var(--border);border-radius:var(--radius);overflow:hidden;min-height:300px;">
    <iframe srcdoc="<%= previewHtml.replace(/\"/g, '&quot;') %>" style="width:100%;height:400px;border:none;" title="Maintenance page preview"></iframe>
  </div>
  <div style="padding:1rem;color:var(--text-muted);font-size:0.85rem;">
    Edit the maintenance page settings in <a href="/admin/settings">Settings</a>.
  </div>
</div>

<%- include('partials/footer') %>
