<%- include('partials/header', {title: title}) %>

<div class="page-header">
  <h1 class="page-title">⚙️ Settings</h1>
  <div class="header-actions">
    <a href="/admin/settings/export" class="btn btn-secondary">⬇ Export</a>
  </div>
</div>

<% if (typeof saved !== 'undefined' && saved) { %>
  <div class="alert alert-success">Settings saved successfully.</div>
<% } %>

<form action="/admin/settings" method="POST">
  <div class="card" style="margin-bottom:1.5rem;">
    <div class="card-header"><h2>Panel</h2></div>
    <div class="form-grid">
      <div class="form-group">
        <label class="form-label">Panel Name</label>
        <input class="form-input" type="text" name="panel_name" value="<%= settings.panel_name || 'ReHoster' %>" maxlength="50" />
      </div>
      <div class="form-group">
        <label class="form-label">Theme</label>
        <select class="form-input" name="theme">
          <option value="dark" <%= (settings.theme || 'dark') === 'dark' ? 'selected' : '' %>>Dark</option>
          <option value="light" <%= settings.theme === 'light' ? 'selected' : '' %>>Light</option>
        </select>
      </div>
      <div class="form-group">
        <label class="form-label">Locale</label>
        <select class="form-input" name="locale">
          <option value="en-US" <%= (settings.locale || 'en-US') === 'en-US' ? 'selected' : '' %>>English (US)</option>
          <option value="en-GB" <%= settings.locale === 'en-GB' ? 'selected' : '' %>>English (UK)</option>
          <option value="de-DE" <%= settings.locale === 'de-DE' ? 'selected' : '' %>>German (DE)</option>
          <option value="fr-FR" <%= settings.locale === 'fr-FR' ? 'selected' : '' %>>French (FR)</option>
          <option value="es-ES" <%= settings.locale === 'es-ES' ? 'selected' : '' %>>Spanish (ES)</option>
          <option value="ja-JP" <%= settings.locale === 'ja-JP' ? 'selected' : '' %>>Japanese (JP)</option>
        </select>
        <small class="form-hint">Used for date/time formatting across the panel.</small>
      </div>
      <div class="form-group">
        <label class="form-label">Timezone</label>
        <select class="form-input" name="timezone">
          <option value="UTC" <%= (settings.timezone || 'UTC') === 'UTC' ? 'selected' : '' %>>UTC</option>
          <option value="America/New_York" <%= settings.timezone === 'America/New_York' ? 'selected' : '' %>>America/New_York</option>
          <option value="America/Chicago" <%= settings.timezone === 'America/Chicago' ? 'selected' : '' %>>America/Chicago</option>
          <option value="America/Denver" <%= settings.timezone === 'America/Denver' ? 'selected' : '' %>>America/Denver</option>
          <option value="America/Los_Angeles" <%= settings.timezone === 'America/Los_Angeles' ? 'selected' : '' %>>America/Los_Angeles</option>
          <option value="Europe/London" <%= settings.timezone === 'Europe/London' ? 'selected' : '' %>>Europe/London</option>
          <option value="Europe/Berlin" <%= settings.timezone === 'Europe/Berlin' ? 'selected' : '' %>>Europe/Berlin</option>
          <option value="Asia/Tokyo" <%= settings.timezone === 'Asia/Tokyo' ? 'selected' : '' %>>Asia/Tokyo</option>
          <option value="Australia/Sydney" <%= settings.timezone === 'Australia/Sydney' ? 'selected' : '' %>>Australia/Sydney</option>
        </select>
        <small class="form-hint">Used together with locale for all displayed timestamps.</small>
      </div>
    </div>
  </div>

  <div class="card" style="margin-bottom:1.5rem;">
    <div class="card-header"><h2>Time Server</h2></div>
    <div style="padding:1rem;">
      <% if (networkTime) { %>
        <p><strong>Network UTC Time:</strong> <%= formatDate(networkTime) %></p>
        <p class="text-muted" style="font-size:0.85rem;">Source: <%= networkTimeSource %></p>
      <% } else { %>
        <p class="text-muted">Unable to fetch network time right now.</p>
      <% } %>
      <% if (timeError) { %>
        <div class="alert alert-warning" style="margin-top:0.75rem;">
          Time server check failed: <%= timeError %>
        </div>
      <% } %>
    </div>
  </div>

  <div class="card" style="margin-bottom:1.5rem;">
    <div class="card-header"><h2>Docker</h2></div>
    <div class="form-grid">
      <div class="form-group">
        <label class="form-label">Restart Policy</label>
        <select class="form-input" name="docker_restart_policy">
          <option value="unless-stopped" <%= settings.docker_restart_policy === 'unless-stopped' ? 'selected' : '' %>>unless-stopped</option>
          <option value="always" <%= settings.docker_restart_policy === 'always' ? 'selected' : '' %>>always</option>
          <option value="on-failure" <%= settings.docker_restart_policy === 'on-failure' ? 'selected' : '' %>>on-failure</option>
          <option value="no" <%= settings.docker_restart_policy === 'no' ? 'selected' : '' %>>no</option>
        </select>
      </div>
      <div class="form-group">
        <label class="form-label">Port Range Start</label>
        <input class="form-input" type="number" name="port_range_start" value="<%= settings.port_range_start || '4000' %>" />
      </div>
      <div class="form-group">
        <label class="form-label">Port Range End</label>
        <input class="form-input" type="number" name="port_range_end" value="<%= settings.port_range_end || '4999' %>" />
      </div>
    </div>
  </div>

  <div class="card" style="margin-bottom:1.5rem;">
    <div class="card-header"><h2>Retention</h2></div>
    <div class="form-grid">
      <div class="form-group">
        <label class="form-label">Log Retention (days)</label>
        <input class="form-input" type="number" name="log_retention_days" value="<%= settings.log_retention_days || '30' %>" min="1" max="365" />
      </div>
      <div class="form-group">
        <label class="form-label">Analytics Retention (days)</label>
        <input class="form-input" type="number" name="analytics_retention_days" value="<%= settings.analytics_retention_days || '7' %>" min="1" max="90" />
      </div>
    </div>
  </div>

  <div class="card" style="margin-bottom:1.5rem;">
    <div class="card-header"><h2>Auto Updates</h2></div>
    <div class="form-grid">
      <div class="form-group">
        <label class="form-label">Enable Automatic Git Checks</label>
        <select class="form-input" name="auto_update_check">
          <option value="1" <%= (settings.auto_update_check || '1') === '1' ? 'selected' : '' %>>Enabled</option>
          <option value="0" <%= settings.auto_update_check === '0' ? 'selected' : '' %>>Disabled</option>
        </select>
      </div>
      <div class="form-group">
        <label class="form-label">Check Interval (hours)</label>
        <input class="form-input" type="number" name="auto_update_interval" min="24" step="1" value="<%= settings.auto_update_interval || '24' %>" />
        <small class="form-hint">Conservative minimum is 24 hours. Lower values are ignored at runtime.</small>
      </div>
    </div>
  </div>

  <div class="form-actions">
    <button type="submit" class="btn btn-primary btn-lg">💾 Save Settings</button>
  </div>
</form>

<%- include('partials/footer') %>
