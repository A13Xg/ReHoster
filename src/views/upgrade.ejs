<%- include('partials/header', {title: title}) %>

<div class="page-header">
  <h1 class="page-title">🔄 Upgrade</h1>
</div>

<div class="card" style="max-width:680px;">
  <div class="card-header"><h2>Panel Version</h2></div>
  <div class="detail-list">
    <div class="detail-row">
      <span class="detail-label">Current Version</span>
      <span class="detail-value"><code><%= currentVersion %></code></span>
    </div>
    <% if (updateStatus && updateStatus.latest) { %>
      <div class="detail-row">
        <span class="detail-label">Latest Release</span>
        <span class="detail-value">
          <code><%= updateStatus.latest %></code>
          <% if (updateStatus.updateAvailable) { %>
            <span class="badge badge-warning" style="margin-left:0.5rem;">Update Available</span>
          <% } else { %>
            <span class="badge badge-running" style="margin-left:0.5rem;">Up to Date</span>
          <% } %>
        </span>
      </div>
    <% } %>
    <% if (gitInfo && gitInfo.branch) { %>
      <div class="detail-row">
        <span class="detail-label">Git Branch</span>
        <span class="detail-value"><code><%= gitInfo.branch %></code></span>
      </div>
    <% } %>
    <% if (gitInfo && gitInfo.currentHash) { %>
      <div class="detail-row">
        <span class="detail-label">Current Commit</span>
        <span class="detail-value"><code><%= gitInfo.currentHash.slice(0,10) %></code></span>
      </div>
    <% } %>
  </div>

  <% if (updateStatus && updateStatus.error) { %>
    <div class="alert alert-danger" style="margin:1rem;">
      GitHub release check failed: <%= updateStatus.error %>
    </div>
  <% } %>

  <% if (updateStatus && updateStatus.message && !updateStatus.error) { %>
    <div class="alert <%= updateStatus.updateAvailable ? 'alert-warning' : 'alert-success' %>" style="margin:1rem 0 0;">
      <%= updateStatus.message %>
    </div>
  <% } %>

  <% if (checkResult) { %>
    <div class="alert <%= checkResult.hasUpdates ? 'alert-warning' : (checkResult.message && checkResult.message.toLowerCase().includes('error') ? 'alert-danger' : 'alert-success') %>" style="margin:1rem 0 0;">
      <%= checkResult.message %>
    </div>

    <% if (checkResult.steps && checkResult.steps.length > 0) { %>
      <div style="padding:0.75rem 1rem 0;">
        <table class="table" style="margin-bottom:0;">
          <thead><tr><th>Step</th><th>Status</th><th>Detail</th></tr></thead>
          <tbody>
            <% checkResult.steps.forEach(function(step) { %>
              <tr>
                <td><code><%= step.label %></code></td>
                <td>
                  <% if (step.status === 'ok') { %>
                    <span style="color:var(--color-running);">✓ OK</span>
                  <% } else if (step.status === 'warn') { %>
                    <span style="color:var(--color-warning);">⚠ Warning</span>
                  <% } else if (step.status === 'error') { %>
                    <span style="color:var(--color-failed);">✕ Error</span>
                  <% } else { %>
                    <span style="color:var(--text-muted);"><%= step.status %></span>
                  <% } %>
                </td>
                <td class="text-muted" style="font-size:0.82rem;word-break:break-all;"><%= step.detail || '' %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  <% } %>

  <div class="actions-list" style="padding:1rem;">
    <form action="/admin/upgrade/check" method="POST" style="margin-bottom:0.5rem;">
      <% if (typeof csrfToken !== 'undefined' && csrfToken) { %>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <% } %>
      <button type="submit" class="btn btn-secondary btn-block">🔍 Check for Updates</button>
    </form>
    <form action="/admin/upgrade/apply" method="POST">
      <% if (typeof csrfToken !== 'undefined' && csrfToken) { %>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <% } %>
      <button type="submit" class="btn btn-primary btn-block confirm-action" data-confirm="Apply upgrade? This will run git pull and npm install. The server will need to be restarted after.">⬆ Apply Upgrade (git pull)</button>
    </form>
  </div>

  <div style="padding:0 1rem 1rem;color:var(--text-muted);font-size:0.85rem;">
    <p>The upgrade process pulls the latest commits from the git repository, handles shallow clones and dirty working trees automatically, and installs any updated dependencies.
    A manual server restart is required after upgrading.</p>
    <p style="margin-top:0.5rem;">If this panel was not installed via git clone, upgrade is unavailable. Download the latest release manually from
    <a href="https://github.com/A13Xg/ReHoster/releases" target="_blank" rel="noopener noreferrer">GitHub Releases</a>.</p>
  </div>
</div>

<%- include('partials/footer') %>
